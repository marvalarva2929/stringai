require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def ccache_enabled?(podfile_properties)
  # Environment variable takes precedence
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']
  
  # Fall back to Podfile properties
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

ENV['RCT_NEW_ARCH_ENABLED'] ||= '0' if podfile_properties['newArchEnabled'] == 'false'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'

prepare_react_native_project!

# Required for MediaPipeTasksVision XCFramework binary pod.
use_frameworks! :linkage => :static

# React Native Firebase resolves the Firebase Apple SDK through Swift Package
# Manager by default, which requires dynamic frameworks — incompatible with the
# static linkage MediaPipe forces above. Fall back to CocoaPods, matching that
# linkage.
#
# Note that the RNFB pods themselves are additionally excluded from
# use_frameworks! via ios.forceStaticLinking in Podfile.properties.json: their
# public headers #import React Native core headers by path
# ("React/RCTBridgeModule.h"), which clang rejects as non-modular includes once
# the pod is a framework module, failing the build under -Werror. Expo applies
# the same exclusion to its own pods for the same reason. Keep that list in sync
# with the installed @react-native-firebase packages.
$RNFirebaseDisableSPM = true
$RNFirebaseAsStaticFramework = true

# Leaving $RNFirebaseAnalyticsWithoutAdIdSupport unset installs
# FirebaseAnalytics/IdentitySupport, so the IDFA is read once ATT is authorised
# and paid-install attribution works. AdSupport.framework is needed for that.
$RNFirebaseAnalyticsEnableAdSupport = true

target 'StringAI' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(\'expo/bin/autolinking\')',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    # Fix PurchasesHybridCommon SubscriptionPeriod ambiguity with StoreKit on iOS 16+
    hybrid_path = "#{installer.sandbox.root}/PurchasesHybridCommon/ios/PurchasesHybridCommon/PurchasesHybridCommon/StoreProduct+HybridAdditions.swift"
    if File.exist?(hybrid_path)
      content = File.read(hybrid_path)
      unless content.include?('RevenueCat.SubscriptionPeriod)')
        patched = content
          .gsub('subscriptionPeriod: SubscriptionPeriod)', 'subscriptionPeriod: RevenueCat.SubscriptionPeriod)')
          .gsub('subscriptionPeriodUnit: SubscriptionPeriod.Unit)', 'subscriptionPeriodUnit: RevenueCat.SubscriptionPeriod.Unit)')
        File.chmod(0644, hybrid_path)
        File.write(hybrid_path, patched)
      end
    end

    # Align all pod deployment targets to the project minimum to suppress version mismatch warnings
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
      end
    end

    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )
  end

  # React Native Firebase autolinks a build phase that uploads dSYMs to
  # Crashlytics, and it fails the whole build when GoogleService-Info.plist is
  # missing. That plist is not in source control, and the app is deliberately
  # built to run without it (AppDelegate skips FirebaseApp.configure(), and
  # services/analytics.ts reports isAnalyticsConfigured === false) — so a
  # checkout without Firebase set up must still compile. Guard the phase rather
  # than letting it decide that.
  #
  # post_integrate, not post_install: CocoaPods adds this phase to the user
  # project during integration, which happens after post_install runs. Re-applied
  # on every pod install, since the phase is regenerated from RNFB's
  # react-native.config.js each time.
  post_integrate do |installer|
    guard = <<~SH
      # Added by Podfile post_integrate — see docs/FIREBASE_SETUP.md
      if [ ! -f "${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/GoogleService-Info.plist" ]; then
        echo "warning: GoogleService-Info.plist is not in the app bundle — skipping the Crashlytics dSYM upload. Crash reports will not be symbolicated. See docs/FIREBASE_SETUP.md"
        exit 0
      fi
    SH

    installer.aggregate_targets.each do |aggregate_target|
      user_project = aggregate_target.user_project
      next if user_project.nil?

      patched = false
      user_project.native_targets.each do |native_target|
        native_target.shell_script_build_phases.each do |phase|
          next unless phase.name.to_s.include?('[RNFB] Crashlytics Configuration')
          next if phase.shell_script.include?('skipping the Crashlytics dSYM upload')
          phase.shell_script = guard + phase.shell_script
          patched = true
        end
      end
      user_project.save if patched
    end
  end
end
