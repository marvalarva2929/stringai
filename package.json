{
  "name": "stringai",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:all": "eas build --platform all",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test:tone": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/toneAnalysis.test.ts",
    "test:intonation": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/intonationStability.test.ts",
    "test:bowgeometry": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/bowBoxGeometry.test.ts",
    "test:bowdirection": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/bowDirection.test.ts",
    "test:bowusage": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/bowUsage.test.ts",
    "test:notefusion": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/noteFusion.test.ts",
    "test:notegrouping": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/noteGrouping.test.ts",
    "test:phrases": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/detectPhrases.test.ts",
    "test:phrasefeatures": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/phraseFeatures.test.ts",
    "test:patterns": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/patternDetection.test.ts",
    "test:issues": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/practiceIssues.test.ts",
    "test:curation": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/practiceCuration.test.ts",
    "test:detection": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/detectionCoverage.test.ts",
    "test:corpus": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/audioCorpus.test.ts",
    "test:pipeline": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/sessionPipeline.test.ts",
    "test:entitlements": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/entitlements.test.ts",
    "test:all": "npm run test:tone && npm run test:intonation && npm run test:bowgeometry && npm run test:weeklygoal && npm run test:bowdirection && npm run test:bowusage && npm run test:notefusion && npm run test:notegrouping && npm run test:phrases && npm run test:phrasefeatures && npm run test:patterns && npm run test:issues && npm run test:curation && npm run test:detection && npm run test:corpus && npm run test:pipeline && npm run test:entitlements",
    "test:weeklygoal": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/weeklyGoal.test.ts",
    "calibrate:intonation": "node --experimental-strip-types --loader ./test/ts-resolver.mjs test/calibrateIntonation.ts",
    "synth:gen": "node --experimental-strip-types test/generate-synth.ts",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.39.0",
    "expo": "~54.0.0",
    "expo-av": "~16.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "pose-camera": "file:./modules/pose-camera",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^7.0.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "^0.5.1",
    "video-audio-extractor": "file:./modules/video-audio-extractor",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~13.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
