# Client environment (Expo). Copy to `.env` and fill in.
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time and are
# therefore PUBLIC — anyone can read them out of the shipped app. Only keys that
# are safe to expose belong here. Server-side secrets are listed at the bottom
# and are set on Supabase, never in this file.
#
# For EAS builds these must also exist in EAS environment variables for the
# `preview` and `production` environments (see eas.json), or the built app ships
# with them undefined and silently disables the corresponding feature.

# ── Supabase ──────────────────────────────────────────────────
# Project settings → API. The anon key is safe to publish; RLS is what protects
# the data. Without these, isSupabaseConfigured is false: no auth, no session
# history, no AI coaching.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── RevenueCat ────────────────────────────────────────────────
# RevenueCat dashboard → Project settings → API keys → *public* SDK key.
#
# REQUIRED TO SHIP. The app is subscription-only: without this key
# isPurchasesConfigured is false, purchasePackage throws "Subscriptions are not
# available on this build", and no user can get past the paywall onto the app.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_xxxxxxxxxxxxxxxx
# Android is not wired (no google-services.json, no Play products). Leave blank
# until Android actually ships.
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# ──────────────────────────────────────────────────────────────
# NOT set here — for reference, so nothing is discovered late:
#
#   Supabase Edge Function secrets  (supabase secrets set KEY=value)
#     HF_TOKEN                    Hugging Face token. AI coaching + Maestro
#                                 chat run on DeepSeek V4 Flash via the HF
#                                 router. Unset = both silently fall back / fail.
#     REVENUECAT_WEBHOOK_SECRET   Shared secret; the same string goes in
#                                 RevenueCat → Integrations → Webhooks.
#     (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically.)
#
#   Firebase                      ios/StringAI/GoogleService-Info.plist, added
#                                 to the Xcode target. Not an env var, and not
#                                 in source control. See docs/FIREBASE_SETUP.md.
#
#   EAS                           `eas init` writes extra.eas.projectId into
#                                 app.json. Required before `eas build`.
#
# Full status: docs/LAUNCH_INTEGRATIONS.md
